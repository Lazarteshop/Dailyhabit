import { onCall, HttpsError } from 'firebase-functions/v2/https';
import * as admin from 'firebase-admin';

export const claimNextPendingReceipt = onCall(
  { region: 'asia-southeast1', enforceAppCheck: true },
  async (request) => {
    // 1. Authenticate caller and verify current Firestore account status
    if (!request.auth) {
      throw new HttpsError('unauthenticated', 'Caller must be authenticated.');
    }

    const callerUid = request.auth.uid;
    const db = admin.firestore();

    // Verify real-time status in Firestore (guarding against stale/revoked JWT custom claims)
    const userDoc = await db.collection('users').doc(callerUid).get();
    if (!userDoc.exists) {
      throw new HttpsError('not-found', 'User record not found.');
    }

    const userData = userDoc.data()!;
    if (userData.role !== 'ADMIN_ASSISTANT' || userData.status !== 'ACTIVE') {
      throw new HttpsError('permission-denied', 'Caller is not an active Admin Assistant.');
    }

    // 2. Atomic Transaction Execution
    return await db.runTransaction(async (transaction) => {
      // Query oldest unassigned queue projection
      const queueQuery = db.collection('assistant_queue_projections')
        .where('status', '==', 'PENDING_ASSIGNMENT')
        .orderBy('createdAt', 'asc')
        .limit(1);

      const snapshot = await transaction.get(queueQuery);
      if (snapshot.empty) {
        throw new HttpsError('not-found', 'No pending receipts available in queue.');
      }

      const projectionDoc = snapshot.docs[0];
      const receiptId = projectionDoc.id;
      const masterReceiptRef = db.collection('payment_receipts').doc(receiptId);
      const projectionRef = projectionDoc.ref;

      // Concurrently read master receipt
      const masterDoc = await transaction.get(masterReceiptRef);
      if (!masterDoc.exists) {
        throw new HttpsError('internal', 'Master receipt missing.');
      }

      const masterData = masterDoc.data()!;
      const projectionData = projectionDoc.data()!;

      // Validate preconditions
      if (projectionData.status !== 'PENDING_ASSIGNMENT' || projectionData.assignedAssistantId != null ||
          masterData.status !== 'PENDING_ASSIGNMENT' || masterData.assignedAssistantId != null) {
        throw new HttpsError('aborted', 'Concurrency conflict: Item already claimed. Please retry.');
      }

      const now = admin.firestore.Timestamp.now();
      const expiresAt = admin.firestore.Timestamp.fromMillis(now.toMillis() + (15 * 60 * 1000)); // 15-min lease

      // Atomically lock both records
      transaction.update(projectionRef, {
        status: 'ASSIGNED',
        assignedAssistantId: callerUid,
        assignedAt: now,
        expiresAt: expiresAt,
      });

      transaction.update(masterReceiptRef, {
        status: 'ASSIGNED',
        assignedAssistantId: callerUid,
        assignedAt: now,
        assignmentExpiresAt: expiresAt,
        auditTrail: admin.firestore.FieldValue.arrayUnion({
          action: 'ASSIGNED_TO_ASSISTANT',
          actorUid: callerUid,
          timestamp: now,
        }),
      });

      return {
        receiptId: receiptId,
        amountCentavos: masterData.amountCentavos,
        gcashReferenceNumber: masterData.gcashReferenceNumber,
        quarantineStoragePath: masterData.quarantineStoragePath,
        expiresAt: expiresAt.toDate().toISOString(),
      };
    });
  }
);
