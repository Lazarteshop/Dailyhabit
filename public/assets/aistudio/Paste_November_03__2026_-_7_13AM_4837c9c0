rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isMainAdmin() {
      return isAuthenticated() && request.auth.token.role == 'MAIN_ADMIN' && request.auth.token.status == 'ACTIVE';
    }
    function isAdminAssistant() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN_ASSISTANT' && request.auth.token.status == 'ACTIVE';
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. USER PRIVATE RECORD ---
    match /users/{userId} {
      allow read: if isUser(userId) || isMainAdmin();
      // Server-controlled creation via Cloud Function or restricted initial scaffold
      allow create: if isUser(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'role', 'status', 'wallets', 'security'])
        && request.resource.data.role == 'USER'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.wallets.aiCoinsBalance == 0
        && request.resource.data.wallets.aiPocketMoneyCentavos == 0
        && request.resource.data.wallets.pendingWithdrawalCentavos == 0;
      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayNameMasked', 'updatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'wallets', 'security']);
    }

    // --- 2. USER PUBLIC PROFILE ---
    match /user_public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'avatarUrl', 'bio', 'followerCount', 'followingCount', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 50
        && request.resource.data.handle is string && request.resource.data.handle.size() >= 3 && request.resource.data.handle.size() <= 30;
    }

    // --- 3. HANDLE REGISTRY (IMMUTABLE RESERVATIONS) ---
    match /handle_registry/{handle} {
      allow read: if true;
      allow write: if false; // Exclusively written via backend transaction
    }

    // --- 4. POSTS & COMMENTS (INHERITED AUDIENCE MODEL) ---
    match /posts/{postId} {
      function isPostVisible() {
        return resource.data.visibility == 'PUBLIC' 
          || isUser(resource.data.authorId) 
          || (resource.data.visibility == 'FOLLOWERS_ONLY' && exists(/databases/$(database)/documents/users/$(resource.data.authorId)/followers/$(request.auth.uid)))
          || isMainAdmin();
      }

      allow read: if isPostVisible();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorId', 'caption', 'mediaUrl', 'mediaType', 'visibility', 'likeCount', 'commentCount', 'createdAt', 'updatedAt'])
        && request.resource.data.visibility in ['PUBLIC', 'FOLLOWERS_ONLY', 'PRIVATE']
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'visibility', 'updatedAt']);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isMainAdmin());

      // Comments subcollection inheriting exact post visibility
      match /comments/{commentId} {
        allow read: if isPostVisible();
        allow create: if isAuthenticated()
          && isPostVisible()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'content', 'createdAt'])
          && request.resource.data.content is string && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 1000;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isMainAdmin());
      }
    }

    // --- 5. SOCIAL GRAPH (LIKES & FOLLOWS) ---
    match /posts/{postId}/likes/{userId} {
      allow read: if true;
      allow create, delete: if isUser(userId);
    }

    match /users/{targetUserId}/followers/{followerUserId} {
      allow read: if true;
      allow create, delete: if isUser(followerUserId);
    }

    // --- 6. AI SHOPS (PUBLIC SHOWCASE VS. PRIVATE SETTINGS) ---
    match /ai_shops/{shopId} {
      allow read: if true;
      allow write: if false; // Cloud Functions manage tier upgrades via AIC token burns
    }

    match /ai_shops/{shopId}/private_settings/{settingId} {
      allow read: if isUser(resource.data.ownerId) || isMainAdmin();
      allow write: if false; // Backend only
    }

    // --- 7. PAYMENT RECEIPTS (FINANCIAL EVIDENCE) ---
    match /payment_receipts/{receiptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid 
        || isMainAdmin()
        || (isAdminAssistant() && resource.data.assignedAssistantId == request.auth.uid)
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_ASSIGNMENT'
        && request.resource.data.assignedAssistantId == null
        && request.resource.data.keys().hasOnly(['receiptId', 'userId', 'amountCentavos', 'gcashReferenceNumber', 'status', 'assignedAssistantId', 'quarantineStoragePath', 'createdAt'])
        && request.resource.data.amountCentavos is int && request.resource.data.amountCentavos > 0
        && request.resource.data.gcashReferenceNumber is string && request.resource.data.gcashReferenceNumber.size() >= 8 && request.resource.data.gcashReferenceNumber.size() <= 32;
    }

    // --- 8. ASSISTANT QUEUE PROJECTIONS (MINIMAL METADATA QUEUE) ---
    match /assistant_queue_projections/{projectionId} {
      allow read: if isMainAdmin() || (
        isAdminAssistant() && (
          resource.data.status == 'PENDING_ASSIGNMENT' 
          || resource.data.assignedAssistantId == request.auth.uid
        )
      );
    }

    // --- 9. WITHDRAWAL REQUESTS ---
    match /withdrawal_requests/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid 
        || isMainAdmin()
        || (isAdminAssistant() && resource.data.assignedAssistantId == request.auth.uid)
      );
    }

    // --- 10. AD CAMPAIGNS ---
    match /ad_campaigns/{campaignId} {
      allow read: if resource.data.status == 'ACTIVE' 
        || (isAuthenticated() && resource.data.advertiserId == request.auth.uid)
        || isMainAdmin();
    }

    // --- 11. IMMUTABLE SYSTEM LEDGERS & AUDIT LOGS ---
    match /ledger_journals/{journalId} {
      allow read: if isMainAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isMainAdmin();
    }
  }
}
